   "source": [
    "import pandas as pd\n",
    "\n",
    "# Example CSV downloaded from data.gov.uk\n",
    "df = pd.read_csv(\"tube_station_entries_exits.csv\")\n",
    "\n",
    "df[\"baseline\"] = df.groupby(\"station_name\")[\"entries\"].transform(\"mean\")\n",
    "df[\"overcrowding_index\"] = df[\"entries\"] / df[\"baseline\"] * 100\n",
    "\n",
    "print(df.head())"
   ]
